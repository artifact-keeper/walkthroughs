# Copy to .env (up.sh does this automatically and fills in the secrets).
# .env is gitignored. Values marked GENERATED are replaced by up.sh.

# Backend and web images: the :dev builds of main (pinned by digest). The Hugging Face format
# is on main and in releases, but this walkthrough needs two fixes that are only on main:
#   - artifact-keeper#5145 (HTTP Range on /resolve/, PR #5205, main 944f34cf), and
#   - the hosted snapshot_download fix (see README.md, "Images"); until it is in a :dev image,
#     gate G5 reports that one check as BLOCKED(ak-fix).
# Override for one run with AK_BACKEND_IMAGE / AK_WEB_IMAGE. compose/VERSIONS records the
# commits of the reference run.
BACKEND_IMAGE=ghcr.io/artifact-keeper/artifact-keeper-backend:dev@sha256:f60236fb4c46fe6c16befbf0430371f3cd19f62cc4a4443e18f338ed2d6c71f1
WEB_IMAGE=ghcr.io/artifact-keeper/artifact-keeper-web:dev@sha256:ddc8125ba8c5c8403962fabd3b769598004695728753fbdf21e149c0ce3b839d

# GENERATED: openssl rand -base64 48 (stock default is denylisted; backend exits)
JWT_SECRET=__GENERATE__
# GENERATED: openssl rand -base64 32 (stock placeholder is rejected; backend exits)
AK_WEBHOOK_SECRET_KEY=__GENERATE__
# GENERATED: admin password; setting it skips the first-boot setup lock.
ADMIN_PASSWORD=__GENERATE__

# The only host port: 127.0.0.1:HTTPS_PORT -> Caddy :443 (image builds, screenshots, host scripts).
HTTPS_PORT=30449

# The stack's network (a /24). Change it if it collides with a network on your host. The lab
# Hub gets .200 of it, and only that address is let through the SSRF guard.
AK_NET_SUBNET=172.31.80.0/24
# The disconnected network of step 7 (internal: no route out). Only Caddy and the offline
# workstation are on it.
AK_OFFLINE_SUBNET=172.31.81.0/24
