# Copy to .env (up.sh does this automatically and fills in the secrets).
# .env is gitignored. Values marked GENERATED are replaced by up.sh.

# Backend and web images. The Hugging Face format is in releases, but this walkthrough needs two
# fixes that are on main and not in a release yet (both ship in 1.12.0):
#   - artifact-keeper#5145 (HTTP Range on /resolve/, PR #5205, main 944f34cf);
#   - artifact-keeper#5280 (hosted snapshot_download, PR #5300, main 6c701cd4).
# No :dev image built from 6c701cd4 or later existed when this was written (2026-11-05: :dev was
# 951cf1ce, before the fix), so the default is still a local build of the #5300 branch
# (709e3f15; its Hugging Face code is identical to main at 6c701cd4; README.md, "Images").
# Once :dev is built from 6c701cd4 or later, use it (pin it by digest):
#   BACKEND_IMAGE=ghcr.io/artifact-keeper/artifact-keeper-backend:dev@sha256:...
# With an older image everything runs, and gate G5 reports the hosted snapshot check as
# BLOCKED(ak-fix). Override for one run with AK_BACKEND_IMAGE / AK_WEB_IMAGE.
# compose/VERSIONS records the commits of the reference run.
BACKEND_IMAGE=ghcr.io/artifact-keeper/artifact-keeper-backend:dev   (or the first release)
# Without #5300, :dev runs everything, and gate G5 reports the hosted snapshot check as
# BLOCKED(ak-fix). Override for one run with AK_BACKEND_IMAGE / AK_WEB_IMAGE.
# compose/VERSIONS records the commits of the reference run.
BACKEND_IMAGE=localhost/ak-backend:hf-709e3f15
WEB_IMAGE=ghcr.io/artifact-keeper/artifact-keeper-web:dev@sha256:ddc8125ba8c5c8403962fabd3b769598004695728753fbdf21e149c0ce3b839d

# GENERATED: openssl rand -base64 48 (stock default is denylisted; backend exits)
JWT_SECRET=__GENERATE__
# GENERATED: openssl rand -base64 32 (stock placeholder is rejected; backend exits)
AK_WEBHOOK_SECRET_KEY=__GENERATE__
# GENERATED: admin password; setting it skips the first-boot setup lock.
ADMIN_PASSWORD=__GENERATE__

# The only host port: 127.0.0.1:HTTPS_PORT -> Caddy :443 (image builds, screenshots, host scripts).
HTTPS_PORT=30449

# The stack's network (a /24). Change it if it collides with a network on your host. The lab
# Hub gets .200 of it, and only that address is let through the SSRF guard.
AK_NET_SUBNET=172.31.80.0/24
# The disconnected network of step 7 (internal: no route out). Only Caddy and the offline
# workstation are on it.
AK_OFFLINE_SUBNET=172.31.81.0/24
