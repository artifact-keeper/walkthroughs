# Copy to .env (up.sh does this automatically and fills in the secrets).
# .env is gitignored. Values marked GENERATED are replaced by up.sh.

# Backend and web images. The agentplugins format first ships in Artifact Keeper 1.12.0;
# until that release exists the default is the first main build that carries it
# (commit c3a650e, artifact-keeper#5256). Once 1.12.0 is out, set
#   BACKEND_IMAGE=ghcr.io/artifact-keeper/artifact-keeper-backend:1.12.0
# The web :dev build has the Agent Plugins setup tab (artifact-keeper-web 895d28d).
# Digests of the images the reference run used are in compose/VERSIONS.
BACKEND_IMAGE=ghcr.io/artifact-keeper/artifact-keeper-backend:sha-c3a650e
WEB_IMAGE=ghcr.io/artifact-keeper/artifact-keeper-web:dev

# GENERATED: openssl rand -base64 48 (stock default is denylisted; backend exits)
JWT_SECRET=__GENERATE__
# GENERATED: openssl rand -base64 32 (stock placeholder is rejected; backend exits)
AK_WEBHOOK_SECRET_KEY=__GENERATE__
# GENERATED: admin password; setting it skips the first-boot setup lock.
ADMIN_PASSWORD=__GENERATE__

# The only host port: 127.0.0.1:HTTPS_PORT -> Caddy :443 (humans, screenshots, host scripts).
HTTPS_PORT=30447

# The stack's network (a /24). Change it if it collides with a network on your host.
AK_NET_SUBNET=172.31.72.0/24
