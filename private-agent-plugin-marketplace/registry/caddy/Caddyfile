# Caddy for the ak-agents stack: TLS from Caddy's internal CA, no plain-HTTP listener.
# Derived from the upstream docker/Caddyfile, with:
#   - the site name fixed to ak.internal (plus localhost/127.0.0.1 for the host port
#     127.0.0.1:30447 used by humans, screenshots and host-side scripts),
#   - `tls internal` (Caddy's local CA; up.sh exports the root to
#     registry/out/ak-internal-ca.crt and the client image trusts it),
#   - only the routes this walkthrough uses,
#   - an access log that replaces the token of /agentplugins/t/<token>/... with
#     REDACTED (Caddy already redacts the Authorization header),
#   - Referrer-Policy: no-referrer on the token route, as the backend documents. The backend
#     build sha-c3a650e sends strict-origin-when-cross-origin there, because its global
#     security-headers layer overwrites the route's header (findings.md, F1); Caddy restores it.
#   - mirror.internal: static files from registry/out/mirror (gate G5's tampered mirror).
{
	# Clients that connect by IP (the host port) send no SNI; give them the
	# ak.internal certificate.
	default_sni ak.internal
	local_certs
	auto_https disable_redirects
}

(access_log) {
	log {
		output stdout
		format filter {
			wrap json
			request>uri regexp "^/agentplugins/t/[^/]+/" "/agentplugins/t/REDACTED/"
			request>headers>Referer delete
		}
	}
}

ak.internal, localhost, 127.0.0.1 {
	tls internal
	import access_log
	reverse_proxy /api/* backend:8080
	reverse_proxy /health backend:8080
	reverse_proxy /livez backend:8080
	reverse_proxy /readyz backend:8080
	reverse_proxy /swagger-ui* backend:8080
	reverse_proxy /agentplugins/t/* backend:8080 {
		header_down Referrer-Policy no-referrer
	}
	reverse_proxy /agentplugins/* backend:8080
	reverse_proxy /general/* backend:8080
	reverse_proxy web:3000
}

mirror.internal {
	tls internal
	import access_log
	root * /srv/mirror
	file_server
}
