# Caddy for the ak-gate stack: one site, ak.internal, TLS from Caddy's internal CA.
# Derived from the upstream docker/Caddyfile (same backend routes, trimmed to the five
# package formats this walkthrough proxies), with:
#   - the site name fixed to ak.internal (plus localhost/127.0.0.1 for the host port
#     127.0.0.1:HTTPS_PORT used by humans, screenshots and host-side scripts),
#   - `tls internal` (Caddy's local CA; the root is exported by up.sh to
#     registry/out/ak-internal-ca.crt and trusted by every client container),
#   - no plain-HTTP site and no HTTP-to-HTTPS redirect (nothing listens on :80).
{
	# Clients that connect by IP (the host port) send no SNI; give them the
	# ak.internal certificate.
	default_sni ak.internal
	local_certs
	auto_https disable_redirects
}

(backend_routes) {
	reverse_proxy /api/* backend:8080
	reverse_proxy /health backend:8080
	reverse_proxy /livez backend:8080
	reverse_proxy /readyz backend:8080
	reverse_proxy /metrics backend:8080
	reverse_proxy /swagger-ui* backend:8080
	# The five package formats this walkthrough puts behind the gate, plus the
	# generic route (used to show that it refuses a scanning Remote).
	reverse_proxy /go/* backend:8080
	reverse_proxy /cargo/* backend:8080
	reverse_proxy /npm/* backend:8080
	reverse_proxy /debian/* backend:8080
	reverse_proxy /alpine/* backend:8080
	reverse_proxy /general/* backend:8080
}

ak.internal, localhost, 127.0.0.1 {
	tls internal
	log {
		output stdout
		format json
	}
	import backend_routes
	reverse_proxy web:3000
}
