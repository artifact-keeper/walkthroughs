# Go: every module and every checksum-database lookup goes through the registry.
# sum.golang.org is reached through the proxy's /sumdb/ route, so GOSUMDB stays on.
GOPROXY=https://ak.internal/go/go-proxy
GOSUMDB=sum.golang.org
GOFLAGS=-mod=mod
GOTOOLCHAIN=local
GOMODCACHE=/tmp/gomod
GOCACHE=/tmp/gocache
GOPATH=/tmp/go
HOME=/tmp
SSL_CERT_FILE=/run/ak/ca.crt
