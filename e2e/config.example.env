# ~/.config/ak-e2e/config.env: non-secret settings for the nightly runner (ak-e2e.service
# reads it as an EnvironmentFile). Secrets go in their own files next to it, mode 600:
#   ~/.config/ak-e2e/gh-token                  GH_TOKEN: issue reporting (E2E_REPORT=github)
#   ~/.config/ak-e2e/claude-code-oauth-token   CLAUDE_CODE_OAUTH_TOKEN: plugin walkthrough, G4

# dry-run (default): print the issues it would open or close. github: post them.
E2E_REPORT=dry-run

# Every walkthrough on main is tested. To test a walkthrough PR before it merges, label the PR
# "e2e"; or list extra branches here (space separated, quoted).
#E2E_EXTRA_REFS="docs/my-walkthrough"

# Artifact Keeper versions, in run order: release (latest GitHub release) and dev (:dev).
#E2E_VERSIONS="release dev"
# Pin a track's tags instead of resolving them, e.g. while a release is being cut:
#E2E_RELEASE_BACKEND_TAG=1.11.11
#E2E_RELEASE_WEB_TAG=1.11.2

# Where nights are written (runs/<date>/), and how many to keep.
#E2E_HOME=/home/<user>/ak-e2e
#E2E_KEEP_NIGHTS=30
