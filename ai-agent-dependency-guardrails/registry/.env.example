# Copy to .env (up.sh does this automatically and fills in the secrets).
# .env is gitignored. Values marked GENERATED are replaced by up.sh.

# Backend and web images: the 1.11.7 release, pinned by digest (see compose/VERSIONS; the
# other images are pinned in compose/compose.override.yml).
# Switch to a locally built image (a fix branch) with AK_BACKEND_IMAGE=... registry/up.sh.
BACKEND_IMAGE=ghcr.io/artifact-keeper/artifact-keeper-backend:1.11.7@sha256:81051e8120211248ec2e2f87a913fd95053a4e7a05584fc24d05c05fc55eda80
WEB_IMAGE=ghcr.io/artifact-keeper/artifact-keeper-web:1.11.1@sha256:0d1db2f50b4403359de323f46a9607dc4782c9fa198ce0dd53a1f313854cccfe

# GENERATED: openssl rand -base64 48 (stock default is denylisted; backend exits)
JWT_SECRET=__GENERATE__
# GENERATED: openssl rand -base64 32 (stock placeholder is rejected; backend exits)
AK_WEBHOOK_SECRET_KEY=__GENERATE__
# GENERATED: admin password; setting it skips the first-boot setup lock.
ADMIN_PASSWORD=__GENERATE__

# The only host port: 127.0.0.1:HTTPS_PORT -> Caddy :443 (humans, screenshots, host scripts).
HTTPS_PORT=30445

# The two networks, /24 each: ak-agent-net (registry, lab upstream at .200) and agent-net
# (the sandbox, internal). Change them if they collide with a network on your host.
AK_NET_SUBNET=172.31.50.0/24
AGENT_NET_SUBNET=172.31.51.0/24
