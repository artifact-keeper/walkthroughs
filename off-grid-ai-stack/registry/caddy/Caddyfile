# Caddy for the ak-offgrid stack: TLS from Caddy's internal CA, no plain-HTTP listener.
# Derived from the upstream docker/Caddyfile, with:
#   - the site name fixed to ak.internal (plus localhost/127.0.0.1 for the host port
#     127.0.0.1:30450 used for image pulls and host-side scripts),
#   - `tls internal` (Caddy's local CA; up.sh exports the root to
#     registry/out/ak-internal-ca.crt and every client image trusts it). Caddy's CA lives in
#     the caddy_data volume, so the certificate is the same on the seed and the site network,
#   - only the routes this walkthrough uses: the API, metrics, and the format routes of the
#     whole stack: the OCI distribution API (/v2) for images, /pypi and /npm for packages,
#     /huggingface for the model, /mcp for the MCP registry and /agentplugins for plugins. The
#     web UI gets everything else.
{
	# Clients that connect by IP (the host port) send no SNI; give them the
	# ak.internal certificate.
	default_sni ak.internal
	local_certs
	auto_https disable_redirects
}

ak.internal, localhost, 127.0.0.1 {
	tls internal
	log {
		output stdout
		format json
	}
	request_body {
		max_size 4GB
	}
	reverse_proxy /api/* backend:8080
	reverse_proxy /health backend:8080
	reverse_proxy /livez backend:8080
	reverse_proxy /readyz backend:8080
	reverse_proxy /metrics backend:8080
	reverse_proxy /v2/* backend:8080
	reverse_proxy /v2 backend:8080
	reverse_proxy /pypi/* backend:8080
	reverse_proxy /npm/* backend:8080
	reverse_proxy /huggingface/* backend:8080
	reverse_proxy /mcp/* backend:8080
	reverse_proxy /agentplugins/* backend:8080
	reverse_proxy web:3000
}
