# Copy to .env (up.sh does this automatically and fills in the secrets).
# .env is gitignored. Values marked GENERATED are replaced by up.sh.

# Backend, web and scanner-adapter images, pinned by digest. This walkthrough needs features
# that are on Artifact Keeper main and not in a release yet (they ship in 1.12.0): cache-only
# Remotes (#5315), UPSTREAM_FETCHED (#5316, and the cold-HEAD probe #5347), the upstream-jobs
# switch (#5317), the scanner adapter's offline mode (#5314), cache seeding (#5333), the
# agentplugins Remote (#5334), config export with upstream_mode (#5335, #5407), the model-file
# scanner (#5337), commit-pinned Hugging Face paths (#5313), Remotes created with their egress
# proxy (#5402), the background MCP sync (#5404) and the targeted MCP seed (#5408). The
# defaults are the CI images of main at 88f23c51. Override for one run with AK_BACKEND_IMAGE /
# AK_WEB_IMAGE / AK_SCANNER_ADAPTER_IMAGE (the nightly runner does). compose/VERSIONS records
# the images of the reference run.
BACKEND_IMAGE=ghcr.io/artifact-keeper/artifact-keeper-backend:dev@sha256:1314a083cfecc388e6f4107248817eff50b7c103913849e225c32c781dcd2427
WEB_IMAGE=ghcr.io/artifact-keeper/artifact-keeper-web:dev@sha256:e05124d427420f81fbc2656bbad1cd50a5e3333a5cfae27859a61c6f1812e5ff
SCANNER_ADAPTER_IMAGE=ghcr.io/artifact-keeper/artifact-keeper-scanner-adapter:dev@sha256:d44dacfa01a846b27e247e021eb58df78c3b5c55ccd03a3c1872e25233699cb1

# GENERATED: openssl rand -base64 48 (stock default is denylisted; backend exits)
JWT_SECRET=__GENERATE__
# GENERATED: openssl rand -base64 32 (stock placeholder is rejected; backend exits)
AK_WEBHOOK_SECRET_KEY=__GENERATE__
# GENERATED: admin password; setting it skips the first-boot setup lock.
ADMIN_PASSWORD=__GENERATE__
# GENERATED: the scanner adapter's shared token for its vulnerability-DB routes.
SCANNER_ADAPTER_TOKEN=__GENERATE__

# The only host port: 127.0.0.1:HTTPS_PORT -> Caddy :443 (image pulls, host scripts).
HTTPS_PORT=30450

# The seed network (a /24 with a route out) and the site network (internal: no gateway, no
# route out). Change them if they collide with networks on your host. On either network the
# backend is .250 and the egress ledger .200.
AK_SEED_SUBNET=172.31.84.0/24
AK_SITE_SUBNET=172.31.85.0/24
