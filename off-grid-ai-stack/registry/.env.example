# Copy to .env (up.sh does this automatically and fills in the secrets).
# .env is gitignored. Values marked GENERATED are replaced by up.sh.

# Backend, web and scanner-adapter images. This walkthrough needs features that are on
# Artifact Keeper main and not in a release yet (they ship in 1.12.0): cache-only Remotes
# (#5315), the UPSTREAM_FETCHED audit event (#5316), the upstream-jobs switch (#5317), the
# scanner-adapter offline mode (#5314), cache seeding (#5333), the agentplugins Remote (#5334),
# config export (#5335), the model-file scanner (#5337) and commit-pinned Hugging Face paths
# (#5313, main f0d9b638). No :dev image built from f0d9b638 or later existed when this was
# written (2026-11-05: :dev was 6c701cd4), so the defaults are local builds of main at
# 0bffa44c (README.md, "Images"):
#   podman build -f docker/Dockerfile.backend -t localhost/ak-backend:offgrid-0bffa44c .
#   podman build -f docker/Dockerfile.scanner-adapter -t localhost/ak-scanner-adapter:offgrid-0bffa44c .
# Once :dev is built from f0d9b638 or later, use it, pinned by digest:
#   BACKEND_IMAGE=ghcr.io/artifact-keeper/artifact-keeper-backend:dev@sha256:...
#   SCANNER_ADAPTER_IMAGE=ghcr.io/artifact-keeper/artifact-keeper-scanner-adapter:dev@sha256:...
# Override for one run with AK_BACKEND_IMAGE / AK_WEB_IMAGE / AK_SCANNER_ADAPTER_IMAGE.
# compose/VERSIONS records the images of the reference run.
BACKEND_IMAGE=localhost/ak-backend:offgrid-0bffa44c
WEB_IMAGE=ghcr.io/artifact-keeper/artifact-keeper-web:dev@sha256:7a0ec1f45d4eb59ff617a69e80e7622c85cc3b36679a594b8c2a33fb4fe79146
SCANNER_ADAPTER_IMAGE=localhost/ak-scanner-adapter:offgrid-0bffa44c

# GENERATED: openssl rand -base64 48 (stock default is denylisted; backend exits)
JWT_SECRET=__GENERATE__
# GENERATED: openssl rand -base64 32 (stock placeholder is rejected; backend exits)
AK_WEBHOOK_SECRET_KEY=__GENERATE__
# GENERATED: admin password; setting it skips the first-boot setup lock.
ADMIN_PASSWORD=__GENERATE__
# GENERATED: the scanner adapter's shared token for its vulnerability-DB routes.
SCANNER_ADAPTER_TOKEN=__GENERATE__

# The only host port: 127.0.0.1:HTTPS_PORT -> Caddy :443 (image pulls, host scripts).
HTTPS_PORT=30450

# The seed network (a /24 with a route out) and the site network (internal: no gateway, no
# route out). Change them if they collide with networks on your host. On either network the
# backend is .250 and the egress ledger .200.
AK_SEED_SUBNET=172.31.84.0/24
AK_SITE_SUBNET=172.31.85.0/24
