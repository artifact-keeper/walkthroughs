{"version": 2, "width": 120, "height": 34, "timestamp": 1793943661, "title": "Disconnect: cache-only, jobs paused, the network cut", "env": {"TERM": "xterm-256color", "SHELL": "/bin/bash"}}
[0.008, "o", "\u001b[1;32m~/off-grid-ai-stack$\u001b[0m make disconnect\r\n"]
[1.018, "o", "flows/disconnect.sh\r\n"]
[1.176, "o", "\r\n== 1. pause the scheduled upstream jobs, and let a running MCP sync finish\r\n"]
[1.235, "o", "  PATCH /api/v1/admin/settings/system: HTTP 200\r\n"]
[1.269, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"upstream_jobs_paused\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"upstream_jobs_paused_source\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"database\"\u001b[0m\u001b[1;39m}\u001b[0m\r\n"]
[1.322, "o", "  mcp-official sync: {\"lastStartedAt\":null,\"lastFinishedAt\":null}\r\n\r\n== 2. every Remote to cache-only"]
[1.323, "o", "\r\n"]
[1.372, "o", "  oci-dockerhub  HTTP 200 {\"upstream_mode\":\"cache_only\",\"effective_upstream_mode\":\"cache_only\"}\r\n"]
[1.418, "o", "  oci-ghcr       HTTP 200 {\"upstream_mode\":\"cache_only\",\"effective_upstream_mode\":\"cache_only\"}\r\n"]
[1.464, "o", "  pypi-remote    HTTP 200 {\"upstream_mode\":\"cache_only\",\"effective_upstream_mode\":\"cache_only\"}\r\n"]
[1.512, "o", "  npm-remote     HTTP 200 {\"upstream_mode\":\"cache_only\",\"effective_upstream_mode\":\"cache_only\"}\r\n"]
[1.559, "o", "  hf-hub         HTTP 200 {\"upstream_mode\":\"cache_only\",\"effective_upstream_mode\":\"cache_only\"}\r\n"]
[1.602, "o", "  mcp-official   HTTP 200 {\"upstream_mode\":\"cache_only\",\"effective_upstream_mode\":\"cache_only\"}\r\n"]
[1.645, "o", "  plugins        HTTP 200 {\"upstream_mode\":\"cache_only\",\"effective_upstream_mode\":\"cache_only\"}\r\n"]
[1.645, "o", "\r\n== 3. the configuration as it leaves the network\r\n"]
[2.02, "o", "  13 repositories; the Remotes as exported:\r\n"]
[2.023, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"key\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"hf-hub\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"upstream_mode\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"cache_only\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"cache_ttl_seconds\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m315360000\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"on_upstream_not_found\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"keep\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"egress\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"explicit\"\u001b[0m\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\u001b[0m\u001b[1;34m\"key\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"mcp-official\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"upstream_mode\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"cache_only\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"cache_ttl_seconds\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m315360000\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"on_upstream_not_found\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"keep\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"egress\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"explicit\"\u001b[0m\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\u001b[0m\u001b[1;34m\"key\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"npm-remote\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"upstream_mode\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"cache_only\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"cache_ttl_seconds\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m315360000\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"on_upstream_not_found\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"keep\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"egress\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"explicit\"\u001b[0m\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\u001b[0m\u001b[1;34m\"key\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"oci-dockerhub\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"upstream_mode\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"cache_only\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"cache_ttl_seconds\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m315360000\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"on_upstream_not_found\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"keep\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"egress\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"explicit\"\u001b[0m\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\u001b[0m\u001b[1;34m\"key\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"oci-ghcr\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"upstream_mode\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"cache_only\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"cache_ttl_seconds\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m315360000\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"on_upstream_not_found\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"keep\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"egress\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"explicit\"\u001b[0m\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\u001b[0m\u001b[1;34m\"key\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"plugins\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"upstream_mode\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"cache_only\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"cache_ttl_seconds\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m315360000\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"on_upstream_not_found\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"keep\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"egress\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"explicit\"\u001b[0m\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\u001b[0m\u001b[1;34m\"key\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"pypi-remote\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"upstream_mode\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"cache_only\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"cache_ttl_seconds\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m315360000\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"on_upstream_not_found\"\u001b[0m\u001b[1;39m:\u001b[0m\