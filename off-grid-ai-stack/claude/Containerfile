# Claude Code for the best-effort step: Node 22 from oci-dockerhub and @anthropic-ai/claude-code
# (with its native linux-x64 package) from npm-remote, both through Artifact Keeper. No
# credential stays in the image; claude/run.sh passes the token per run.
ARG REG=localhost:30450
ARG NODE_IMAGE
FROM ${REG}/oci-dockerhub/${NODE_IMAGE}
ARG AK=https://ak.internal:30450
ARG CLAUDE_CODE_VERSION
COPY .work/ak-internal-ca.crt /usr/local/share/ca-certificates/ak-internal-ca.crt
ENV NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/ak-internal-ca.crt
RUN --mount=type=secret,id=ak_token,required=true \
    set -eu; t=$(cat /run/secrets/ak_token); r="${AK#https://}/npm/npm-remote/"; \
    printf 'registry=https://%s\n//%s:_authToken=%s\n' "$r" "$r" "$t" > /tmp/npmrc; \
    npm install -g --userconfig /tmp/npmrc --no-fund --no-audit "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}"; \
    rm -f /tmp/npmrc; npm cache clean --force; claude --version
RUN useradd --create-home --uid 1001 dev 2>/dev/null || true
ENV CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    DISABLE_AUTOUPDATER=1 \
    DISABLE_TELEMETRY=1
