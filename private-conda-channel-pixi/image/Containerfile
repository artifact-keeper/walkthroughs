# syntax=docker/dockerfile:1
# acme-analytics: pixi on UBI micro, built from the registry only.
#
# Builder: the pixi image (pulled through the registry's ghcr.io proxy, pinned by
# digest), the internal CA, /etc/pixi/config.toml mirroring conda-forge to the
# registry, `pixi install --locked` with the consumer token as a build secret,
# then the attestation gate over every internal package in pixi.lock.
# Runtime: UBI micro (through the registry's Red Hat proxy, pinned by digest)
# with the solved environment and a `pixi shell-hook` entrypoint; no pixi, no
# package manager, no credentials.
#
# Build context: the private-conda-channel-pixi/ directory (see image/build.sh).
ARG REGISTRY=localhost:30444
ARG PIXI_IMAGE=${REGISTRY}/oci-ghcr/prefix-dev/pixi:0.81.0@sha256:788ae451641666e2d1f79d3dbe35392dfc7e9b394b16a3acb75c347f3badb2ab
ARG MICRO_IMAGE=${REGISTRY}/oci-redhat/ubi9/ubi-micro:9.8@sha256:7a0454cbd9bd847e8f6a63b6f0254a6efbeb6e0ed71a5d824a4f6cccbe626650

FROM ${PIXI_IMAGE} AS builder
COPY image/.work/ak-internal-ca.crt /usr/local/share/ca-certificates/ak-internal-ca.crt
RUN update-ca-certificates >/dev/null
COPY client/.work/pixi-config.toml /etc/pixi/config.toml
COPY client/.work/rattler-config.toml /etc/rattler/config.toml
# The key that signs internal packages' publish attestations (also served from
# https://ak.internal/api/v1/repositories/trust/download/conda-ci-cosign.pub).
COPY image/.work/conda-ci-cosign.pub /etc/acme/conda-ci-cosign.pub
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    PIXI_NO_TELEMETRY=1 \
    RATTLER_CACHE_DIR=/root/.cache/rattler

WORKDIR /app
ARG PROJECT=project
COPY ${PROJECT}/pixi.toml ${PROJECT}/pixi.lock ./

# Install exactly what the lock says. The token is a build secret: it is not in
# any layer, and pixi.lock carries no credentials.
RUN --mount=type=secret,id=rattler-auth,target=/run/secrets/rattler-auth.json \
    --mount=type=cache,target=/root/.cache/rattler \
    RATTLER_AUTH_FILE=/run/secrets/rattler-auth.json pixi install --locked

# Attestation gate: every internal package in pixi.lock must carry a CEP-27
# attestation signed by the trusted key, bound to the locked sha256. cosign,
# jq and curl come from conda-forge through the registry, like everything else.
COPY image/verify-attestations.sh /usr/local/bin/verify-attestations.sh
ARG VERIFY_EXTRA_ENV=
RUN --mount=type=secret,id=rattler-auth,target=/run/secrets/rattler-auth.json \
    --mount=type=cache,target=/root/.cache/rattler \
    env RATTLER_AUTH_FILE=/run/secrets/rattler-auth.json ${VERIFY_EXTRA_ENV} \
    pixi exec -s cosign -s jq -s curl -s bash -- \
      bash /usr/local/bin/verify-attestations.sh /app/pixi.lock

# Activation script for the runtime: the environment's variables, then exec.
RUN pixi shell-hook --locked -s bash > /app/activate.sh && echo 'exec "$@"' >> /app/activate.sh

FROM ${MICRO_IMAGE}
LABEL org.opencontainers.image.title="acme-analytics" \
      org.opencontainers.image.description="pixi environment on UBI micro, built from the ak.internal registry only"
WORKDIR /app
COPY --from=builder /app/pixi.toml /app/pixi.lock /app/activate.sh /app/
COPY --from=builder /app/.pixi/envs/default /app/.pixi/envs/default
USER 1001
ENTRYPOINT ["/bin/bash", "/app/activate.sh"]
CMD ["acme-report"]
