# Copy to .env (up.sh does this automatically and fills in the secrets).
# .env is gitignored. Values marked GENERATED are replaced by up.sh.

# Backend and web images. The MCP Registry repository type is not on main yet: it is
# artifact-keeper#5257 (issue #5253) and the web UI is artifact-keeper-web#1077. Until they
# merge, build both images from those branches (README.md, "Images") and use these local tags.
# Once #5257 is merged, set
#   BACKEND_IMAGE=ghcr.io/artifact-keeper/artifact-keeper-backend:dev   (or the first release)
#   WEB_IMAGE=ghcr.io/artifact-keeper/artifact-keeper-web:dev
# The commits the reference run used are in compose/VERSIONS.
BACKEND_IMAGE=localhost/ak-backend:mcp-c89f9cea
WEB_IMAGE=localhost/ak-web:mcp-89313d4

# GENERATED: openssl rand -base64 48 (stock default is denylisted; backend exits)
JWT_SECRET=__GENERATE__
# GENERATED: openssl rand -base64 32 (stock placeholder is rejected; backend exits)
AK_WEBHOOK_SECRET_KEY=__GENERATE__
# GENERATED: admin password; setting it skips the first-boot setup lock.
ADMIN_PASSWORD=__GENERATE__

# The only host port: 127.0.0.1:HTTPS_PORT -> Caddy :443 (humans, screenshots, host scripts).
HTTPS_PORT=30448

# The stack's network (a /24). Change it if it collides with a network on your host. The lab
# upstream registry gets .200 of it, and only that address is let through the SSRF guard.
AK_NET_SUBNET=172.31.76.0/24

# SHA-256 fingerprints of the certificates allowed to sign MCPB bundles (comma separated).
# GENERATED: bundles/signer.sh writes the lab signer's fingerprint here.
MCP_TRUSTED_BUNDLE_SIGNERS=
