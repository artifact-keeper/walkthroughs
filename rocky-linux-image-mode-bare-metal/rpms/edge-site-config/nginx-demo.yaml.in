# Seeded into /var/lib/rancher/rke2/server/manifests by edge-site-manifests.service
# (RKE2 auto-applies everything in that directory). The image is pulled via the
# docker.io mirror in /etc/rancher/rke2/registries.yaml, i.e. through Artifact Keeper.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: nginx-demo
  namespace: default
  labels:
    app: nginx-demo
    edge-site/config-release: "@RELEASE@"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: nginx-demo
  template:
    metadata:
      labels:
        app: nginx-demo
        edge-site/config-release: "@RELEASE@"
    spec:
      containers:
        - name: nginx
          image: docker.io/library/nginx:alpine
          ports:
            - containerPort: 80
---
apiVersion: v1
kind: Service
metadata:
  name: nginx-demo
  namespace: default
  labels:
    app: nginx-demo
    edge-site/config-release: "@RELEASE@"
spec:
  type: NodePort
  selector:
    app: nginx-demo
  ports:
    - port: 80
      targetPort: 80
      nodePort: 30090
